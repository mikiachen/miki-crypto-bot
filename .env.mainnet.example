# Arc MAINNET overlay — copy values from official docs when published.
# Usage:
#   1) Keep secrets in .env (ARC_PRIVATE_KEY, ARC_WALLET, X_BEARER_TOKEN, …)
#   2) Fill this file after Circle/Arc publish mainnet RPC + chain id
#   3) python3 scripts/arc_preflight.py --mainnet
#   4) ./scripts/run_arc_desk.sh --live   (after sourcing — see note below)
#
# Do NOT guess factory/curve CAs. Paste from the explorer only.
# Never put ARC_PRIVATE_KEY, API keys, or a bearer token in this file.
# UNISWAP_API_KEY belongs in .env only. The desk watches the official
# trade-api chain list; Arc 5042 listed still does not sign or broadcast
# until ARC_UNI_SEND=1. Private key never leaves this machine.
# ARC_UNI_SEND=0
# ARC_UNI_SLIPPAGE=1.0

ARC_NETWORK=mainnet
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_BACKUP_RPC_URL=https://rpc.drpc.mainnet.arc.io
ARC_CHAIN_ID=5042
ARC_EXPLORER=https://arc-scan.org
ARC_SYMBOL=USDC

# Warp-only until Tolly/DYOR ABIs verified on mainnet
ARC_PADS=warp
ARC_ALLOW_PLACEHOLDERS=0

# Paste mainnet Warp curve(s) OR factory (prefer factory for new launches)
# ARC_WARP_CAS=0x...
# ARC_DEFAULT_CURVE=0x...
# ARC_WARP_FACTORY=0x...
# ARC_FACTORY_TOPIC0=0x...              # optional; keccak of TokenCreated(...)

# Risk — keep tiny on day one
ARC_BET_PCT=0.10
ARC_BET_HARD_CAP=1
ARC_MAX_SLOTS=2
ARC_DAY_LOSS_USDC=10
ARC_HARD_STOP=0.85
ARC_TRAIL_ARM=2.0
ARC_TRAIL_GIVEBACK=0.20
ARC_TAKE_PROFIT=8
ARC_MAX_HOLD_SEC=2700
ARC_LIVE=0
ARC_FORCE_BROADCAST=0

# To apply over .env without merging by hand:
#   set -a; source .env; source .env.mainnet; set +a
#   python3 scripts/arc_preflight.py --mainnet
#   python3 scripts/smoke_arc_buy_sell.py          # dry
#   python3 scripts/smoke_arc_buy_sell.py --live --usdc 0.5
