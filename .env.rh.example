# Robinhood Chain (4663) desk — copy to .env.rh and fill the blanks.
#   cp .env.rh.example .env.rh
#   python3 scripts/rh_preflight.py
#   ./scripts/run_rh_desk_ui.sh
#
# .env.rh is gitignored. Never commit a filled copy.

DESK_CHAIN=robinhood

# Wallet — required
RH_PRIVATE_KEY=
RH_WALLET=

# RPC — public default works; keys are optional backups
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# RH_BACKUP_RPC_URL=
# TATUM_API_KEY=
# RH_ALCHEMY_KEY=
# ALPHA_VANTAGE_API_KEY=

# 0 = read-only, 1 = sign and broadcast swaps
RH_UNI_SEND=0

# Size
RH_BET_HARD_CAP=1.5
RH_MAX_SLOTS=2
RH_MAX_BOOK_USDG=3.0
RH_DAY_LOSS_USDG=10

# Entry
RH_UNIVERSE=liquid
RH_INTRADAY=1
RH_SESSION_SWING=1
RH_BREAKOUT_MODE=near
RH_EQUITY_TA=1
RH_EQUITY_TA_MODE=soft
RH_RHJ_MARKET=1
RH_MAX_PREMIUM_PCT=4
RH_MIN_LIQ_USDG=50000
RH_MIN_ROUNDTRIP=0.97
RH_REENTRY_SEC=1800

# Exit
RH_HARD_STOP=0.97
RH_TAKE_PROFIT=1.06
RH_RSI_EXIT=70
RH_EMA_STOP_PCT=1.5
RH_MAX_HOLD_SEC=21600

# Execution
RH_SLIPPAGE_PCT=1.0
RH_SELL_SLIPPAGE_PCT=5
RH_SCAN_EVERY=8
RH_EXIT_EVERY=3
RH_GAS_REFUEL=1
